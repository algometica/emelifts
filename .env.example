# Local
DATABASE_URL="file:./dev.db"

# Neon (production): in prisma/schema.prisma set provider = "postgresql"
# then paste the pooled URL from console.neon.tech
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"
COACH_EMAIL="em@emelifts.com"
COACH_PASSWORD="set-a-real-coach-password"

# Paddle Billing. sandbox | production. Do not leave blank in production.
PADDLE_ENV="sandbox"
# Server only. Never import this in a client component.
PADDLE_API_KEY=""
PADDLE_WEBHOOK_SECRET=""
# Public client-side token. Sandbox starts with test_
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=""
# Price IDs (pri_...) from Catalog, not product IDs (pro_...)
PADDLE_PRICE_MONTHLY=""
PADDLE_PRICE_CHALLENGE=""
PADDLE_PRICE_WEDDING=""
# In Paddle: Checkout > Checkout settings > default payment link
# Sandbox: https://your-preview-or-domain/enroll  (not localhost)
# Live: same path on an approved domain.
